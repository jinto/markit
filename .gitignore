# Swift Package Manager
.build/
.swiftpm/
# Package.resolved는 커밋한다. 라이브러리라면 무시하는 것이 관례지만 이 저장소는
# 서명된 앱을 배포하므로 릴리스가 재현 가능해야 한다. swift-markdown을
# `from: "0.6.0"`으로 받고 있어 고정하지 않으면 0.x 어느 버전이든 올 수 있고,
# 이 프로젝트는 SourceLocation.column이 UTF-8 바이트 오프셋이라는 미묘한 동작에
# 의존한다 — 0.x 마이너 범프가 그것을 바꿔도 SemVer 위반이 아니다.

# LLVM coverage artifacts
*.profraw
*.profdata

# 배포 산출물 (scripts/make-app.sh, scripts/make-dmg.sh)
dist/
